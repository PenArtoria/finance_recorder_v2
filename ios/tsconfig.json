{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["../windows/src/renderer/src/*"],
      "@shared/*": ["../windows/src/shared/*"]
    }
  },
  "include": ["src/**/*", "../windows/src/renderer/src/env.d.ts"]
}
